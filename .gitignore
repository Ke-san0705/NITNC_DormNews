# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/

# Editors and OS
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db

# Generated reports may include private form answers and drafts
output/
**/output/
*.pdf
*.png

# Microsoft Forms / Excel data must not be pushed
*.xlsx
*.xls
*.xlsm
*.csv
!samples/動作確認用_架空回答.csv
!samples/動作確認用_架空回答.xlsx

# Photographs and issue assets: publishing rights/privacy must be reviewed
*.jpg
*.jpeg
*.webp
*.gif
*.heic

# Keep empty asset folders
!assets/.gitkeep
!issues/**/assets/.gitkeep

# Untracked temporary files
*.log
*.tmp
*.bak
~$*
